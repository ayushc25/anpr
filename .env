# Camera workers: the modular ONNX pipeline runs as separate OS processes
# under `python -m backend.app.cli supervisor`. With this at 0 the API stops
# starting the legacy in-process single-frame workers (services/detection.py
# + EasyOCR), so the supervisor is the only thing doing inference.
#
# The supervisor is NOT optional once this is 0 — the API alone runs no
# inference at all.
ENABLE_LEGACY_CAMERA_WORKERS=0
